<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#0D1420">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PreCog Earn Companion (Pilot)"
        android:textColor="#36F5BE"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Opt-in, visible, revocable. This app hashes locally only after you switch it on. No wallet, no keys, no network, no background mining."
        android:textColor="#9EB0B9"
        android:textSize="14sp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/consent_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="I consent to this device working while this screen is visible"
        android:textColor="#EEF7F6" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Consent not granted. No work is running."
        android:textColor="#EEF7F6"
        android:textSize="13sp" />
</LinearLayout>
